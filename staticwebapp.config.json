{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    { "route": "/en/", "redirect": "/", "statusCode": 301 },
    { "route": "/en/recruiter/", "redirect": "/recruiter/", "statusCode": 301 },
    { "route": "/en/colophon/", "redirect": "/colophon/", "statusCode": 301 },
    { "route": "/en/garage/", "redirect": "/garage/", "statusCode": 301 },
    { "route": "/recrutador/", "redirect": "/pt/recrutador/", "statusCode": 301 },
    { "route": "/como-foi-feito/", "redirect": "/pt/como-foi-feito/", "statusCode": 301 },
    { "route": "/garagem/", "redirect": "/pt/garagem/", "statusCode": 301 },
    { "route": "/cv/manuel-bravo-cv.pdf", "redirect": "/cv/manuel-bravo-resume.pdf", "statusCode": 301 },
    {
      "route": "/fonts/v1/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/media/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Blazor-Enhanced-Nav": "allow",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' __INLINE_SCRIPT_HASHES__; style-src 'self'; img-src 'self' data:; frame-src https://www.youtube-nocookie.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".avif": "image/avif",
    ".webp": "image/webp",
    ".woff2": "font/woff2",
    ".dat": "application/octet-stream",
    ".blat": "application/octet-stream"
  }
}
