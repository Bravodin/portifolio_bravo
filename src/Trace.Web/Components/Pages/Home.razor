@page "/"
@page "/en"
@page "/es"
@inject PageContext Page

@* The ride (docs/ux/sitemap.md). For now: hero + stage 1 with the Dyno; the other stages come next. *@
<PageTitle>@Page.T("page.home.title")</PageTitle>

<section class="hero" aria-labelledby="hero-name">
    <h1 id="hero-name">@Identity.Name</h1>
    <p class="hero-role">@Identity.Role</p>
    <p class="hero-tagline">@Identity.Tagline</p>
    <p class="hero-actions">
        <a class="btn btn-primary" href="@Page.PathFor(PageKey.Recruiter)">@Page.T("cta.recruiter")</a>
    </p>
</section>

<section class="stage" id="client" aria-labelledby="stage-client">
    <p class="hud-label">@Page.T("stage.label") @Client.Number</p>
    <h2 id="stage-client">@Client.Title</h2>
    <dl class="par">
        <dt>@Page.T("stage.problem")</dt>
        <dd>@Client.Problem</dd>
        <dt>@Page.T("stage.action")</dt>
        <dd>@Client.Action</dd>
        <dt>@Page.T("stage.result")</dt>
        <dd>@Client.Result</dd>
    </dl>
    <p class="stage-story">@Client.Story[0]</p>
    <DynoIsland @rendermode="InteractiveWebAssembly" Copy="@DynoCopy.From(Page.Content)" />
    <ul class="chips" aria-label="Tech">
        @foreach (var tech in Client.Tech)
        {
            <li>@tech</li>
        }
    </ul>
</section>

@code {
    private Identity Identity => Page.Content.Identity;

    private Stage Client => Page.Content.Stage("client");
}
