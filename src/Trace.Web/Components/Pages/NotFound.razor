@page "/not-found"
@layout MainLayout

@* Becomes dist/404.html. SWA serves one 404 for every path (responseOverrides is site-wide),
   so it speaks all three languages (ADR-0009). *@
<PageTitle>404 · TRACE</PageTitle>

<article class="prose">
    <h1>404</h1>
    <p lang="en">This page went off track. <a href="/">Back to the start</a></p>
    <p lang="es">Esta página se salió de la pista. <a href="/es/">Volver al inicio</a></p>
    <p lang="pt-BR">Essa página saiu da pista. <a href="/pt/">Voltar ao início</a></p>
</article>
