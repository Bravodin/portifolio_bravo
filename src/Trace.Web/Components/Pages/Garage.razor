@page "/garage"
@page "/es/garaje"
@page "/pt/garagem"
@using System.Globalization
@inject PageContext Page
@inject MediaCatalog Media

@* Full gallery (docs/ux/sitemap.md, P4): the on-board Shorts, then photos by category, with credits.
   Each photo links to its large version and each video to its MP4 (L0); site.js opens them in a lightbox instead, without leaving the page. *@
<PageTitle>@Page.T("page.garage.title")</PageTitle>

<article class="garage-page"
         data-lightbox-label="@Page.T("lightbox.label")"
         data-lightbox-close="@Page.T("lightbox.close")"
         data-lightbox-prev="@Page.T("lightbox.prev")"
         data-lightbox-next="@Page.T("lightbox.next")"
         data-lightbox-video-label="@Page.T("lightbox.videoLabel")"
         data-lightbox-video-prev="@Page.T("lightbox.videoPrev")"
         data-lightbox-video-next="@Page.T("lightbox.videoNext")">
    <p><a href="@Page.PathFor(PageKey.Home)#garage">@Page.T("garage.back")</a></p>
    <h1>@Page.T("garage.title")</h1>
    <p class="section-intro">@Page.T("garage.intro")</p>

    <section aria-labelledby="garage-videos">
        <h2 id="garage-videos">@Page.T("garage.videos")</h2>
        <ul class="video-grid">
            @foreach (var video in Media.Videos)
            {
                <li><VideoFacade Video="video" /></li>
            }
        </ul>
    </section>

    @foreach (var (category, heading) in Sections)
    {
    <section aria-labelledby="garage-@category">
        <h2 id="garage-@category">@Page.T(heading)</h2>
        <ul class="photo-grid">
            @foreach (var photo in Media.Photos.Where(p => p.Category == category))
            {
                <li>
                    <figure>
                        <a class="photo-link" href="@Large(photo.Id)" title="@Page.T("garage.open")" data-enhance-nav="false">
                            <Picture Id="@photo.Id" Shape="ImageShape.Square" Widths="[320, 640]" Sizes="(min-width: 1024px) 280px, (min-width: 768px) 30vw, 45vw" Width="320" Height="320" />
                        </a>
                        <figcaption>
                            @if (photo.Caption is { } caption)
                            {
                                <span>@caption[Page.Locale]</span>
                            }
                            @if (photo.AiGenerated)
                            {
                                <small class="ai-label">@Page.T("garage.aiIllustration")</small>
                            }
                            else if (photo.Credit is { } credit)
                            {
                                <small>
                                    @if (credit.Url is { } url)
                                    {
                                        <a href="@url" rel="noopener" target="_blank">@Credit(credit.Name)</a>
                                    }
                                    else
                                    {
                                        @Credit(credit.Name)
                                    }
                                </small>
                            }
                        </figcaption>
                    </figure>
                </li>
            }
        </ul>
    </section>
    }
</article>

@code {
    // Photo grids in page order; a category without photos simply renders nothing.
    private static readonly (string Category, string Heading)[] Sections = [("track", "garage.photos"), ("workbench", "garage.workshop"), ("games", "garage.gaming")];

    private string Large(string id) => Media.Image(id, ImageShape.Original, [1600]).In(ImageFormat.Jpeg).Last().Url;

    private string Credit(string name) => string.Format(CultureInfo.InvariantCulture, Page.T("garage.photoCredit"), name);
}
