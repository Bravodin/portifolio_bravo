@page "/colophon"
@using System.Globalization
@page "/es/como-se-hizo"
@page "/pt/como-foi-feito"
@inject PageContext Page
@inject RepoStats Repo
@inject BuildSnapshot Snapshot
@inject MediaCatalog Media

<PageTitle>@Page.T("page.colophon.title")</PageTitle>

<article class="prose colophon"
         data-lightbox-label="@Page.T("lightbox.label")"
         data-lightbox-close="@Page.T("lightbox.close")"
         data-lightbox-prev="@Page.T("lightbox.prev")"
         data-lightbox-next="@Page.T("lightbox.next")">
    <h1>@Page.T("colophon.title")</h1>
    <ul>
        <li>@Page.T("colophon.stack")</li>
        <li>@Page.T("colophon.hosting")</li>
        <li>@Page.T("colophon.type")</li>
        <li>@Page.T("colophon.source") <a href="@RepoUrl">GitHub</a></li>
    </ul>

    @* Built with AI, directed by a human (content inventory §1.2). *@
    <section class="ai-build" aria-labelledby="ai-title">
        <h2 id="ai-title">@Copy.AiTitle</h2>
        <p>@Copy.AiIntro</p>
        <dl class="roles-list">
            @foreach (var role in Copy.Roles)
            {
                <div>
                    <dt>@role.Who</dt>
                    <dd>@role.What</dd>
                </div>
            }
        </dl>

        <h3>@Copy.ReviewsTitle</h3>
        <ul class="reviews">
            @foreach (var review in Copy.Reviews)
            {
                <li>@review</li>
            }
        </ul>

        <h3>@Copy.NumbersTitle</h3>
        <ul class="figures" aria-label="@Copy.NumbersTitle">
            @if (Repo.Commits is { } commits)
            {
                <li><strong>@commits</strong> <span>@Copy.RepoCommits</span></li>
            }
            <li><strong>@Repo.Adrs</strong> <span>@Copy.RepoAdrs</span></li>
            <li><strong>@Repo.TestMethods</strong> <span>@Copy.RepoTests</span></li>
        </ul>
        <p class="hud-label">@Copy.UsagePeriod</p>
        <ul class="figures">
            @foreach (var figure in Copy.Usage)
            {
                <li><strong>@figure.Value</strong> <span>@figure.Label</span></li>
            }
        </ul>
        <p class="figures-note">@Copy.UsageNote</p>
        <p>@Copy.UsageReflection</p>
        <p><a href="@(RepoUrl)/commits/main">@Copy.History ↗</a></p>
    </section>

    @* Latest build: real values from the pipeline run that produced this version (ADR-0007, ADR-0009). *@
    <section class="build-panel" aria-labelledby="build-title">
        <h2 id="build-title">@Copy.Build.Title</h2>
        @if (Snapshot.Build is { } build)
        {
            <p>@Copy.Build.Intro</p>
            <dl class="build-facts">
                <div><dt>@Copy.Build.Number</dt><dd>@build.Number</dd></div>
                <div><dt>@Copy.Build.Commit</dt><dd><a href="@(RepoUrl)/commit/@build.Commit">@build.ShortCommit</a></dd></div>
                <div><dt>@Copy.Build.Branch</dt><dd>@build.Branch</dd></div>
                <div><dt>@Copy.Build.BuiltAt</dt><dd>@build.BuiltAt.ToString("yyyy-MM-dd HH:mm 'UTC'", CultureInfo.InvariantCulture)</dd></div>
                @if (build.TestsPassed is { } passed && build.TestsTotal is { } total)
                {
                    <div><dt>@Copy.Build.Tests</dt><dd class="build-ok">@passed / @total</dd></div>
                }
                @if (build.DomainCoverage is { } coverage)
                {
                    <div><dt>@Copy.Build.Coverage</dt><dd class="build-ok">@coverage.ToString("0.#%", CultureInfo.InvariantCulture)</dd></div>
                }
            </dl>
        }
        else
        {
            <p class="figures-note">@Copy.Build.Local</p>
        }

        @* A screenshot of the run history (content/media/colophon/); links to the large version (shown in the lightbox) so the text is legible. *@
        <figure class="build-shot">
            <a class="photo-link" href="@PipelineLarge" data-enhance-nav="false">
                <Picture Id="@PipelineShot" Widths="[640, 960, 1600]" Sizes="(min-width: 960px) 56rem, 100vw" Width="960" Height="451" />
            </a>
            @if (Media.Item(PipelineShot).Caption is { } caption)
            {
                <figcaption>@caption[Page.Locale]</figcaption>
            }
        </figure>
    </section>

    @* Architecture as an ordered flow: real text (translated, readable by screen readers), arrows drawn in CSS,
       horizontal on wide screens and vertical on phones. *@
    <section class="architecture" aria-labelledby="arch-title">
        <h2 id="arch-title">@Arch.Title</h2>
        <p>@Arch.Intro</p>

        @* Two views of the same steps, chosen with radio buttons (works without JS, arrow keys switch). *@
        <div class="arch-views">
            <fieldset class="arch-toggle">
                <legend class="visually-hidden">@Arch.ViewLabel</legend>
                <input type="radio" name="arch-view" id="arch-view-graph" checked />
                <label for="arch-view-graph">@Arch.GraphView</label>
                <input type="radio" name="arch-view" id="arch-view-list" />
                <label for="arch-view-list">@Arch.ListView</label>
            </fieldset>

            @* Swimlanes: one row per layer; the publishing flow on the left, the access flow on the right,
               Azure Static Web Apps spanning both where they meet. *@
            <div class="arch-lanes" role="group" aria-label="@Arch.GraphView">
                <span class="lane-corner"></span>
                <span class="lane-head lane-head-publish">@Arch.PublishFlow</span>
                <span class="lane-head lane-head-access">@Arch.AccessFlow</span>
                @foreach (var node in Arch.Nodes)
                {
                    <span class="lane-label">@node.Layer</span>
                    @if (node.Flow == "access")
                    {
                        <span class="lane-empty" aria-hidden="true"></span>
                    }
                    <div class="lane-card lane-@node.Flow">
                        <strong>@node.Name</strong>
                        <span>@node.Role</span>
                    </div>
                    @if (node.Flow == "publish")
                    {
                        <span class="lane-empty" aria-hidden="true"></span>
                    }
                }
            </div>

            <ol class="arch-flow">
            @foreach (var node in Arch.Nodes)
            {
                <li class="arch-node">
                    <h3>@node.Name</h3>
                    <p class="arch-role">@node.Role</p>
                    <ul>
                        @foreach (var detail in node.Details)
                        {
                            <li>@detail</li>
                        }
                    </ul>
                    <p class="arch-adrs">
                        <span>@Arch.DecisionsLabel</span>
                        @foreach (var adr in node.Adrs)
                        {
                            <a href="@Repo.AdrUrl(adr)">ADR-@adr</a>
                        }
                    </p>
                </li>
            }
            </ol>
        </div>
    </section>

    <p><a href="@Page.PathFor(PageKey.Home)">@Page.T("colophon.back")</a></p>
</article>

@code {
    private const string RepoUrl = RepoStats.RepoUrl;

    private const string PipelineShot = "colophon-pipeline";

    private string PipelineLarge => Media.Image(PipelineShot, ImageShape.Original, [1600]).In(ImageFormat.Jpeg).Last().Url;

    private ColophonCopy Copy => Page.Content.Colophon;

    private Architecture Arch => Copy.Architecture;
}
