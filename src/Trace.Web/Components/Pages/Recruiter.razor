@page "/recrutador"
@page "/en/recruiter"
@page "/es/reclutador"
@inject PageContext Page
@inject TimeProvider Clock

@* Recruiter Mode (wireframe 06): everything a recruiter screens for, in one screen, no animation,
   printable on one A4 page. Contact is LinkedIn only. *@
<PageTitle>@Page.T("page.recruiter.title")</PageTitle>

<article class="recruiter">
    <div class="recruiter-bar">
        <a class="back" href="@Page.PathFor(PageKey.Home)">‹ @Page.T("recruiter.back")</a>
        <p class="hud-label">@Page.T("recruiter.title")</p>
        <button type="button" class="btn js-only" data-print>⎙ @Page.T("recruiter.print")</button>
    </div>

    <section class="id-card" aria-labelledby="recruiter-name">
        <div class="id-head">
            <Picture Id="profile" Shape="ImageShape.Square" Widths="[160, 320]" Sizes="112px" Width="112" Height="112" Class="portrait" Eager="true" />
            <div>
                <h1 id="recruiter-name">@Identity.Name</h1>
                <p class="id-role">@Identity.Role</p>
            </div>
        </div>
        <dl class="facts">
            <div><dt>@Page.T("recruiter.now")</dt><dd>@Identity.CurrentRole</dd></div>
            <div><dt>@Page.T("recruiter.experience")</dt><dd>@Experience</dd></div>
            <div><dt>@Page.T("recruiter.sectors")</dt><dd>@Identity.Sectors</dd></div>
            <div><dt>@Page.T("recruiter.location")</dt><dd>@Identity.Location</dd></div>
            <div><dt>@Page.T("recruiter.languages")</dt><dd>@Identity.Languages</dd></div>
            <div><dt>@Page.T("recruiter.education")</dt><dd>@Identity.Education</dd></div>
        </dl>
        <p class="id-actions">
            <a class="btn btn-primary" href="@Identity.LinkedIn" rel="noopener" target="_blank">@Page.T("cta.linkedin") ↗</a>
            @if (Identity.CvUrl is { } cv)
            {
                <a class="btn" href="@cv" download>@Page.T("cta.cv")</a>
            }
        </p>
        <p class="id-note">@Page.T("recruiter.contactNote")</p>
    </section>

    <section class="results" aria-labelledby="recruiter-results">
        <h2 id="recruiter-results" class="hud-label">@Page.T("recruiter.results")</h2>
        <ul class="metric-grid">
            @foreach (var metric in Metrics)
            {
                <li class="metric" data-metric="@metric.Id">
                    <span class="metric-before">@metric.Before <span class="metric-arrow" aria-hidden="true">→</span></span>
                    <span class="@AfterClass(metric)">@metric.After</span>
                    @if (ShowDelta(metric))
                    {
                        <span class="metric-delta">@metric.Delta</span>
                    }
                    <span class="metric-label">@metric.Label</span>
                </li>
            }
        </ul>
    </section>

    <section class="stack" aria-labelledby="recruiter-stack">
        <h2 id="recruiter-stack" class="hud-label">@Page.T("recruiter.stack")</h2>
        <ul class="chips">
            @foreach (var tool in Page.Recruiter.CoreStack)
            {
                <li>@tool</li>
            }
        </ul>
    </section>

    <section class="roles" aria-labelledby="recruiter-roles">
        <h2 id="recruiter-roles" class="hud-label">@Page.T("recruiter.roles")</h2>
        <ol>
            @foreach (var role in Page.Content.Log.Take(Page.Recruiter.Roles))
            {
                <li>
                    <span class="role-period">@role.Period</span>
                    <strong>@role.Company · @role.Role</strong>
                    <span class="role-highlight">@role.Highlight</span>
                </li>
            }
        </ol>
    </section>
</article>

@code {
    private Identity Identity => Page.Content.Identity;

    // Computed at build time from the start year, so "20 years" becomes "21 years" without a content edit.
    private string Experience => string.Format(
        System.Globalization.CultureInfo.InvariantCulture,
        Page.T("recruiter.experienceValue"),
        Clock.GetLocalNow().Year - Identity.CareerStartYear,
        Identity.CareerStartYear);

    private IEnumerable<Metric> Metrics => Page.Recruiter.Metrics.Select(Page.Content.Metric);

    // Long values ("Node.js (~80 % migrated)") get a smaller size so the card keeps its shape.
    private static string AfterClass(Metric metric) => metric.After.Length > 10 ? "metric-after metric-after-long" : "metric-after";

    // Show the delta only when it adds information (e.g. "CA API Gateway → Sensedia" needs "−30 %").
    private static bool ShowDelta(Metric metric) => metric.Delta != "—" && metric.Delta != metric.After;
}
