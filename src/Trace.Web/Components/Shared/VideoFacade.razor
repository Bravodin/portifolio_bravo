@using System.Globalization
@inject MediaCatalog Media
@inject PageContext Page

@* Click-to-load facade (ADR-0012). Without JS it's a plain link to the MP4 (L0). site.js swaps it for a <video>
   with the same poster on click, so no video bytes load before that. The file is ours: no third party involved. *@
<figure class="video">
    <a class="video-facade"
       href="@Media.VideoUrl(Video)"
       data-video
       data-title="@Title"
       aria-label="@string.Format(CultureInfo.InvariantCulture, Page.T("video.play"), Title)">
        <Picture Source="Media.Poster(Video, [270, 405])" Sizes="(min-width: 1024px) 270px, 45vw" Width="270" Height="480" Class="video-poster" />
        <span class="video-play" aria-hidden="true">▶</span>
    </a>
    <figcaption>
        <strong>@Title</strong>
        <span>@Video.Description[Page.Locale]</span>
        <small>@string.Format(CultureInfo.InvariantCulture, Page.T("garage.videoCredit"), Video.Credit.Name)</small>
    </figcaption>
</figure>

@code {
    [Parameter, EditorRequired] public VideoItem Video { get; set; } = default!;

    private string Title => Video.Title[Page.Locale];
}
