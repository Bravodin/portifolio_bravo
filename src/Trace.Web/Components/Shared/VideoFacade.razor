@using System.Globalization
@inject MediaCatalog Media
@inject PageContext Page

@* Click-to-load facade (ADR-0010). Without JS it's a plain link to the Short (L0). site.js swaps it for a
   youtube-nocookie iframe on click, so nothing from YouTube loads (and no cookie is set) before that. *@
<figure class="video">
    <a class="video-facade"
       href="@Video.WatchUrl"
       data-youtube="@Video.YoutubeId"
       data-title="@Title"
       aria-label="@string.Format(CultureInfo.InvariantCulture, Page.T("video.play"), Title)">
        @if (Media.Poster(Video, [270, 405]) is { } poster)
        {
            <Picture Source="poster" Sizes="(min-width: 1024px) 270px, 45vw" Width="270" Height="480" Class="video-poster" />
        }
        else
        {
            <span class="video-placeholder"></span>
        }
        <span class="video-play" aria-hidden="true">▶</span>
    </a>
    <figcaption>
        <strong>@Title</strong>
        <span>@Video.Description[Page.Locale]</span>
        <small>@string.Format(CultureInfo.InvariantCulture, Page.T("garage.videoCredit"), Video.Credit.Name)</small>
    </figcaption>
</figure>

@code {
    [Parameter, EditorRequired] public VideoItem Video { get; set; } = default!;

    private string Title => Video.Title[Page.Locale];
}
