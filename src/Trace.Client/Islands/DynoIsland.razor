@using System.Globalization
@using Trace.Domain.Dyno
@implements IAsyncDisposable
@inject TimeProvider Clock

@*
    Stage 1 dyno (docs/ux/interaction-spec.md#dyno-stage-1).
    L0 (prerendered / no JS): the static result card with the measured numbers.
    L2 (after WASM hydration): the interactive run.
    All text comes in through Copy, already in the page's language (ADR-0004).
*@
<section class="dyno" aria-labelledby="dyno-title" data-dyno-state="@StateName">
    <h3 id="dyno-title">@Copy.Title</h3>

    @if (!RendererInfo.IsInteractive)
    {
        <div class="dyno-result" data-testid="dyno-static">
            <p><strong>@Copy.LegacyLabel</strong>: @Copy.MeasuredBefore</p>
            <p><strong>@Copy.NativeLabel</strong>: @Copy.MeasuredAfter</p>
            <p>@Copy.MeasuredDelta</p>
            <p class="dyno-beyond">@Copy.BeyondSpeed</p>
        </div>
    }
    else
    {
        <div class="dyno-lanes">
            @Lane(Copy.LegacyLabel, _run?.LegacyProgress(_elapsed) ?? 0, LegacyShown, _run is not null && _run.IsLegacyDone(_elapsed))
            @Lane(Copy.NativeLabel, _run?.NativeProgress(_elapsed) ?? 0, NativeShown, _run is not null && _run.IsNativeDone(_elapsed))
        </div>

        @if (_state == DynoState.Done && _run is not null)
        {
            <div class="dyno-result" data-testid="dyno-result">
                <p><strong>@Copy.LegacyLabel</strong>: @Seconds(_run.Legacy)</p>
                <p><strong>@Copy.NativeLabel</strong>: @Seconds(_run.Native)</p>
                <p>@Number(_run.SpeedUp, "0.#")× @Copy.FasterLabel</p>
                <p class="dyno-beyond">@Copy.BeyondSpeed</p>
            </div>
        }

        @if (_state == DynoState.Running)
        {
            @if (_elapsed >= SkipAfter)
            {
                <button type="button" class="btn dyno-skip" @onclick="Skip">@Copy.SkipLabel</button>
            }
        }
        else
        {
            <button type="button" class="btn btn-primary dyno-run" @onclick="RunAsync">@(_state == DynoState.Done ? Copy.RunAgainLabel : Copy.RunLabel)</button>
        }

        <p class="visually-hidden" aria-live="polite">@_announcement</p>
    }

    <p class="dyno-footnote">@Copy.Footnote</p>
</section>

@code {
    private static readonly TimeSpan SkipAfter = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan Tick = TimeSpan.FromMilliseconds(50);

    private DynoState _state = DynoState.Idle;
    private DynoRun? _run;
    private TimeSpan _elapsed;
    private string _announcement = string.Empty;
    private CancellationTokenSource? _cts;

    [Parameter, EditorRequired] public DynoCopy Copy { get; set; } = default!;

    /// <summary>Seed source for each run; replaceable in tests.</summary>
    [Parameter] public Func<int> NextSeed { get; set; } = () => Environment.TickCount;

    private string StateName => RendererInfo.IsInteractive ? _state.ToString().ToLowerInvariant() : "static";

    private TimeSpan NativeShown => _run is null ? TimeSpan.Zero : Min(_elapsed, _run.Native);

    private TimeSpan LegacyShown => _run is null ? TimeSpan.Zero : Min(_elapsed, _run.Legacy);

    private async Task RunAsync()
    {
        await StopAsync();
        _run = DynoSimulation.Create(NextSeed());
        _elapsed = TimeSpan.Zero;
        _announcement = string.Empty;
        _state = DynoState.Running;
        _cts = new CancellationTokenSource();
        _ = DriveAsync(_run, _cts.Token);
    }

    private async Task DriveAsync(DynoRun run, CancellationToken token)
    {
        var started = Clock.GetTimestamp();
        var nativeAnnounced = false;
        using var timer = new PeriodicTimer(Tick, Clock);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                _elapsed = Clock.GetElapsedTime(started);
                if (!nativeAnnounced && run.IsNativeDone(_elapsed))
                {
                    nativeAnnounced = true;
                    _announcement = Format(Copy.NativeFinished, Seconds(run.Native));
                }

                if (run.IsLegacyDone(_elapsed))
                {
                    Finish(run);
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Run stopped (skip, run again, or component disposed).
        }
    }

    private async Task Skip()
    {
        await StopAsync();
        if (_run is not null)
        {
            Finish(_run);
        }
    }

    private void Finish(DynoRun run)
    {
        _elapsed = run.Legacy;
        _state = DynoState.Done;
        _announcement = Format(Copy.LegacyFinished, Seconds(run.Legacy));
    }

    private async Task StopAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = null;
        }
    }

    public async ValueTask DisposeAsync() => await StopAsync();

    private static TimeSpan Min(TimeSpan a, TimeSpan b) => a < b ? a : b;

    private static string Format(string template, string value) =>
        string.Format(CultureInfo.InvariantCulture, template, value);

    // InvariantGlobalization (ADR-0004): no culture data in the browser, so the decimal separator comes with the copy.
    private string Number(double value, string format) =>
        value.ToString(format, CultureInfo.InvariantCulture).Replace(".", Copy.DecimalSeparator, StringComparison.Ordinal);

    private string Seconds(TimeSpan value) => Number(value.TotalSeconds, "0.0") + " s";

    private RenderFragment Lane(string label, double progress, TimeSpan shown, bool done) => __builder =>
    {
        <div class="dyno-lane">
            <span class="dyno-label">@label</span>
            <meter min="0" max="1" value="@progress.ToString("0.###", CultureInfo.InvariantCulture)" aria-label="@label"></meter>
            <span class="dyno-timer" aria-hidden="true">@Number(shown.TotalSeconds, "00.0") s @(done ? "✓" : "")</span>
        </div>
    };

    private enum DynoState
    {
        Idle,
        Running,
        Done,
    }
}
