<Project>
  <!-- Shared by every project in the repo. Project files keep only what is specific to them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Quality gate (ADR-0007): warnings fail the build, analyzers and code style run on build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unused usings) to run on build; missing XML docs are not enforced. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- The site's version, shown in the footer next to the build number (SiteVersion). Bumped by .githooks/pre-push
         on every push to main: feat → minor, fix → patch. Don't edit it by hand. -->
    <Version>1.1.0</Version>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
